# Config of one deploy (12-factor III). Copy to .env and change the secrets:
#   cp .env.example .env
# .env is not committed. Every process reads only the variables with its own prefix.
# Values below are for local development; on a server generate secrets, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# === Release ===
# Image tag to run; build with APP_VERSION=$(git rev-parse --short=7 HEAD)
APP_VERSION=dev
REGISTRY=task-scheduler

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskscheduler

# === S3-compatible storage for attachments (RustFS in compose) ===
S3_ROOT_USER=s3admin
S3_ROOT_PASSWORD=s3-dev-password

# === RabbitMQ (profile `full`) ===
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# === Core API ===
CORE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/taskscheduler
CORE_JWT_SECRET=dev-secret-change-me
CORE_SERVICE_TOKEN=dev-service-token
CORE_ML_WEBHOOK_API_KEY=dev-webhook-key
CORE_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Passwordless login by email — demo only, keep false on a real deploy
CORE_DEV_LOGIN=true
# Demo users and projects, loaded by the `migrate` admin process
CORE_SEED_DEMO=true
CORE_S3_ENDPOINT_URL=http://s3:9000
CORE_S3_ACCESS_KEY=s3admin
CORE_S3_SECRET_KEY=s3-dev-password
CORE_S3_BUCKET=attachments
# Services of the `full` profile. Without that profile core-api keeps retrying RabbitMQ in
# the background and /api/v1/ai answers 502; leave both empty to switch the features off.
CORE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
CORE_ML_WORKER_URL=http://ml-worker:8001
CORE_LOG_LEVEL=INFO
CORE_VAPID_PUBLIC_KEY=
CORE_VAPID_PRIVATE_KEY=
CORE_VAPID_CLAIMS_EMAIL=admin@example.com

# === Automation Worker ===
AUTOMATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/taskscheduler
AUTOMATION_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
AUTOMATION_CORE_API_URL=http://core-api:8000
AUTOMATION_ML_WORKER_URL=http://ml-worker:8001
AUTOMATION_SERVICE_TOKEN=dev-service-token

# === ML Worker ===
ML_CORE_API_URL=http://core-api:8000
ML_CORE_API_TOKEN=dev-service-token
ML_WEBHOOK_API_KEY=dev-webhook-key
ML_USE_MOCK_LLM=true
ML_LLM_API_KEY=
ML_LLM_MODEL=claude-sonnet-4-20250514
ML_LLM_BASE_URL=

# === Review Scraper ===
SCRAPER_REVIEW_BOARD_URL=http://mock-review-board:8002
SCRAPER_ML_WORKER_URL=http://ml-worker:8001
SCRAPER_WEBHOOK_API_KEY=dev-webhook-key
SCRAPER_INTERVAL_SECONDS=60
