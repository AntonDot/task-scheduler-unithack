name: Auto Approve to Dev

on:
  pull_request_target: # Изменили триггер
    branches:
      - dev
    types: [opened, reopened, synchronize]

jobs:
  auto-approve:
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
    # Исключаем апрув самого себя, если вы и есть автор PR
    if: github.actor != 'github-actions[bot]'
    
    steps:
      - uses: hmarr/auto-approve-action@v4
        with:
          # По умолчанию используется встроенный токен, 
          # теперь у него точно хватит прав благодаря pull_request_target
          github-token: ${{ secrets.GITHUB_TOKEN }}
