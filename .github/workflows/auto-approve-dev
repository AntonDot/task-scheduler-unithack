name: Auto Approve to Dev

on:
  pull_request_target:
    branches:
      - dev
    types: [opened, reopened, synchronize]

jobs:
  auto-approve:
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: write # Требуется для совершения слияния (merge)
    
    steps:
      # Шаг 1: Одобряем (это у вас уже работает!)
      - name: Approve PR
        uses: hmarr/auto-approve-action@v4
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      # Шаг 2: Сами жмем кнопку Merge через GitHub CLI
      - name: Merge PR
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh pr merge ${{ github.event.pull_request.number }} --merge --delete-branch
