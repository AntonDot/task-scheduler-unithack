# Rendered by the nginx image at container start (envsubst): PORT, CORE_API_URL,
# NGINX_RESOLVER and APP_VERSION come from the environment, nginx's own variables stay as is.

# Access log as one JSON object per line in the same schema as the Python services
# (timestamp, level, message, service.name). Level follows the status code;
# http.request_time is in seconds, numeric — a log store can take quantiles of it.
map $status $log_level {
    ~^5     ERROR;
    ~^4     WARNING;
    default INFO;
}

log_format json escape=json
    '{"timestamp":"$time_iso8601","level":"$log_level",'
    '"message":"$request_method $request_uri $status",'
    '"service.name":"web","service.version":"${APP_VERSION}","logger":"nginx.access",'
    '"http.method":"$request_method","url.path":"$request_uri","http.status_code":$status,'
    '"http.request_time":$request_time,"http.upstream_time":"$upstream_response_time",'
    '"http.response_bytes":$body_bytes_sent,"client.address":"$remote_addr",'
    '"user_agent":"$http_user_agent"}';

server {
    listen ${PORT};
    access_log /dev/stdout json;

    # Resolve the backend name per request (TTL 10s), not once at start: a recreated or
    # scaled core-api gets new addresses and nginx must follow them.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $core_api ${CORE_API_URL};
    root /usr/share/nginx/html;
    index index.html;

    # Service worker must never be cached — browsers need the latest version
    location = /service-worker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }

    # Manifest should also not be long-cached
    location = /manifest.json {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass $core_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /ws {
        proxy_pass $core_api;
        proxy_http_version 1.1;
        proxy_read_timeout 1h;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
