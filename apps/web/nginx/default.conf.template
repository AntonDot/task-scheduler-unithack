# Rendered by the nginx image at container start (envsubst): PORT, CORE_API_URL and
# NGINX_RESOLVER come from the environment, nginx's own variables stay as is.
server {
    listen ${PORT};

    # Resolve the backend name per request (TTL 10s), not once at start: a recreated or
    # scaled core-api gets new addresses and nginx must follow them.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $core_api ${CORE_API_URL};
    root /usr/share/nginx/html;
    index index.html;

    # Service worker must never be cached — browsers need the latest version
    location = /service-worker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }

    # Manifest should also not be long-cached
    location = /manifest.json {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass $core_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /ws {
        proxy_pass $core_api;
        proxy_http_version 1.1;
        proxy_read_timeout 1h;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
